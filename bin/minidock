#!/usr/bin/env bash
set -euo pipefail

repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
if [[ -f $repo/.env ]]; then
  while IFS= read -r line || [[ -n $line ]]; do
    line=${line%$'\r'}
    [[ $line =~ ^[[:space:]]*# || ! $line =~ ^[[:space:]]*(OPENROUTER_API_KEY|OPENROUTER_MODEL)[[:space:]]*= ]] && continue
    name=${BASH_REMATCH[1]}
    value=${line#*=}
    value=${value#\"}; value=${value%\"}
    value=${value#\'}; value=${value%\'}
    if [[ ! -v $name ]]; then
      printf -v "$name" '%s' "$value"
      export "$name"
    fi
  done < "$repo/.env"
fi

api=${MINIDOCK_API_URL:-http://127.0.0.1:8080}
api=${api%/}

ui_program() {
  if [[ -x $repo/bin/minidock-ui ]]; then
    MINIDOCK_REPO="$repo" "$repo/bin/minidock-ui" "$@"
  else
    (cd "$repo/go-runtime" && MINIDOCK_REPO="$repo" go run ./cmd/minidock-ui "$@")
  fi
}

ui_render() {
  ui_program render "$1"
}

usage() {
  cat >&2 <<'EOF'
Usage:
  minidock build [--from-dist|--from-jar] -t NAME PROJECT_DIR|IMAGE.tar[.gz]
  minidock ui [API_URL]
  minidock images
  minidock ask "describe the container you want"
  minidock ask-build -t NAME PROJECT_DIR "describe the image to build"
  minidock run [-m MEMORY] [-c CPU] [-d|--detach] [--network|--no-network] IMAGE COMMAND [ARG...]
  minidock ps [-a|--all]
  minidock stop CONTAINER_ID
  minidock rm CONTAINER_ID
  minidock logs CONTAINER_ID [OFFSET] [LIMIT]

CPU accepts a percentage (50) or CPU count (0.5).
run attaches stdin/stdout when interactive; use -d to run in the background.
EOF
  exit 2
}

command_name=${1:-}
[[ -n $command_name ]] || usage
shift

case "$command_name" in
  ui)
    (($# <= 1)) || usage
    ui_program app "${1:-$api}"
    ;;
  build)
    build_mode=build
    if [[ ${1:-} == --from-dist || ${1:-} == --from-jar ]]; then
      build_mode=${1#--}
      shift
    fi
    [[ ${1:-} == -t && $# -eq 3 ]] || usage
    name=$2
    input=$3
    temporary_archive=
    if [[ -d $input ]]; then
      temporary_archive=$(mktemp --suffix=.tar.gz "${TMPDIR:-/tmp}/minidock-image.XXXXXX")
      trap 'rm -f -- "$temporary_archive"' EXIT
      if [[ $build_mode == from-dist ]]; then
        python3 "$repo/scripts/minidock_build.py" "$input" "$temporary_archive" --from-dist
      elif [[ $build_mode == from-jar ]]; then
        python3 "$repo/scripts/minidock_build.py" "$input" "$temporary_archive" --from-jar
      else
        python3 "$repo/scripts/minidock_build.py" "$input" "$temporary_archive"
      fi
      archive=$temporary_archive
    else
      [[ $build_mode == build ]] || { echo "$build_mode requires a supported source project directory" >&2; exit 2; }
      [[ -f $input ]] || { echo "project directory or image archive not found: $input" >&2; exit 1; }
      archive=$input
    fi
    response=$(curl --fail-with-body -sS -F "name=$name" -F "archive=@$archive" "$api/api/v1/images")
    printf '%s' "$response" | ui_render build
    if [[ -n $temporary_archive && -f $input/package.json ]]; then
      container_port=${MINIDOCK_CONTAINER_PORT:-8080}
      cat <<EOF

Start this static frontend with:
  bin/minidock run -d $name /usr/bin/minidock-web --root /usr/share/minidock/www --listen 0.0.0.0:$container_port
EOF
    fi
    ;;
  images)
    [[ $# -eq 0 ]] || usage
    response=$(curl --fail-with-body -sS "$api/api/v1/images")
    printf '%s' "$response" | ui_render images
    ;;
  ask)
    (($# > 0)) || usage
    prompt=$*
    images_json=$(curl --fail-with-body -sS "$api/api/v1/images") || {
      echo "Could not reach MiniDock's image API at $api. Is the Java control plane running?" >&2
      exit 1
    }
    spec=$(python3 "$repo/scripts/minidock_ask.py" "$prompt" "$images_json") || exit $?
    printf '%s' "$spec" | ui_render plan
    read -r -p 'Start this container? [y/N] ' answer
    [[ $answer == y || $answer == Y || $answer == yes || $answer == YES ]] || {
      echo 'Cancelled; no container was started.'
      exit 0
    }
    payload=$(python3 -c 'import json,sys; spec=json.load(sys.stdin); spec.update(attach=False, tty=False); print(json.dumps(spec))' <<<"$spec")
    if ! response=$(curl --fail-with-body -sS -H 'Content-Type: application/json' -d "$payload" "$api/api/v1/containers"); then
      [[ -z $response ]] || printf '%s\n' "$response" >&2
      exit 1
    fi
    printf '%s' "$response" | ui_render container
    ;;
  ask-build)
    image_name=
    if [[ ${1:-} == -t ]]; then
      [[ $# -ge 4 ]] || usage
      image_name=$2
      project_dir=$3
      shift 3
    else
      [[ $# -ge 2 ]] || usage
      project_dir=$1
      shift
    fi
    prompt=$*
    plan=$(python3 "$repo/scripts/minidock_ask_build.py" "$project_dir" "$image_name" "$prompt") || exit $?
    selection_file=$(mktemp "${TMPDIR:-/tmp}/minidock-build-choice.XXXXXX")
    plan_file=$(mktemp "${TMPDIR:-/tmp}/minidock-build-plan.XXXXXX")
    trap 'rm -f -- "$selection_file" "$plan_file"' EXIT
    printf '%s\n' "$plan" > "$plan_file"
    printf 'AI image build recommendations (no files or image changed yet):\n'
    ui_program select "$plan_file" "$selection_file"
    selected_option=$(cat "$selection_file")
    [[ -n $selected_option ]] || { echo 'Cancelled; no build was started and no image was changed.'; exit 0; }
    option_details=$(python3 -c 'import json,sys; p=json.load(sys.stdin); o=next(x for x in p["options"] if x["id"]==sys.argv[1]); print(json.dumps(o))' "$selected_option" <<<"$plan")
    printf '\n'
    printf '%s' "$option_details" | ui_render plan
    printf '\n'
    cat <<'EOF'
MiniDock maps this choice to fixed adapter code. It does not run model-generated commands.
The selected build tool and project plugins may execute on this host with your user permissions.
EOF
    read -r -p 'Build and stage this image? [y/N] ' answer
    [[ $answer == y || $answer == Y || $answer == yes || $answer == YES ]] || {
      echo 'Cancelled; no build was started and no image was changed.'
      exit 0
    }
    case "$selected_option" in
      build) "$repo/bin/minidock" build -t "$image_name" "$project_dir" ;;
      package-existing-dist) "$repo/bin/minidock" build --from-dist -t "$image_name" "$project_dir" ;;
      go-build) "$repo/bin/minidock" build -t "$image_name" "$project_dir" ;;
      maven-build) "$repo/bin/minidock" build -t "$image_name" "$project_dir" ;;
      package-existing-jar) "$repo/bin/minidock" build --from-jar -t "$image_name" "$project_dir" ;;
      *) echo 'minidock ask-build: selected recipe is not supported' >&2; exit 1 ;;
    esac
    ;;
  ask-build-turn)
    [[ $# -eq 2 ]] || usage
    python3 "$repo/scripts/minidock_ask_build.py" --turn "$1" "$2"
    ;;
  run)
    memory=
    cpu=
    network_enabled=true
    attach=true
    tty=false
    while (($#)); do
      case "$1" in
        -m|--memory) (($# >= 2)) || usage; memory=$2; shift 2 ;;
        -c|--cpu) (($# >= 2)) || usage; cpu=$2; shift 2 ;;
        -d|--detach) attach=false; tty=false; shift ;;
        -i|--interactive) attach=true; shift ;;
        -t|--tty) attach=true; tty=true; shift ;;
        -it|-ti) attach=true; tty=true; shift ;;
        --network) network_enabled=true; shift ;;
        --no-network|--network=none) network_enabled=false; shift ;;
        --) shift; break ;;
        -*) usage ;;
        *) break ;;
      esac
    done
    (($# >= 2)) || usage
    image=$1
    shift
    if [[ $cpu =~ ^[1-9][0-9]?$ ]]; then cpu="${cpu}%"; fi
    payload=$(python3 -c 'import json,sys; image,memory,cpu,network,attach,tty=sys.argv[1:7]; command=sys.argv[7:]; print(json.dumps({"image":image,"command":command,"memory_limit":memory or None,"cpu_limit":cpu or None,"network":network == "true","attach":attach == "true","tty":tty == "true"}))' "$image" "$memory" "$cpu" "$network_enabled" "$attach" "$tty" "$@")
    if ! response=$(curl --fail-with-body -sS -H 'Content-Type: application/json' -d "$payload" "$api/api/v1/containers"); then
      [[ -z $response ]] || printf '%s\n' "$response" >&2
      exit 1
    fi
    if [[ $attach == false ]]; then
      printf '%s' "$response" | ui_render container
    else
      id=$(python3 -c 'import json,sys; print(json.load(sys.stdin)["id"])' <<<"$response")
      printf '%s' "$response" | ui_render container
      repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
      if [[ -x $repo/bin/minidock-attach ]]; then
        MINIDOCK_SOCKET=${MINIDOCK_SOCKET:-/tmp/minidock-runtime.sock} "$repo/bin/minidock-attach" attach "$id"
      else
        (cd "$repo/go-runtime" && MINIDOCK_SOCKET=${MINIDOCK_SOCKET:-/tmp/minidock-runtime.sock} go run ./cmd/minidock attach "$id")
      fi
    fi
    ;;
  ps)
    all=false
    if [[ $# -eq 1 && ( $1 == -a || $1 == --all ) ]]; then
      all=true
    elif [[ $# -ne 0 ]]; then
      usage
    fi
    query=
    [[ $all == false ]] || query='?all=true'
    response=$(curl --fail-with-body -sS "$api/api/v1/containers$query")
    printf '%s' "$response" | ui_render containers
    ;;
  stop)
    [[ $# -eq 1 ]] || usage
    response=$(curl --fail-with-body -sS -X DELETE "$api/api/v1/containers/$1")
    printf '%s' "$response" | ui_render stopped
    ;;
  rm)
    [[ $# -eq 1 && $1 =~ ^[[:xdigit:]]{12}$ ]] || usage
    curl --fail-with-body -sS -X DELETE "$api/api/v1/containers/$1/record" >/dev/null
    printf 'Removed container %s and its saved files.\n' "$1"
    ;;
  logs)
    (($# >= 1 && $# <= 3)) || usage
    id=$1
    offset=${2:-0}
    limit=${3:-1048576}
    curl --fail-with-body -sS "$api/api/v1/containers/$id/logs?offset=$offset&limit=$limit" --output -
    ;;
  *) usage ;;
esac
printf '\n'
