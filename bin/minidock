#!/usr/bin/env bash
set -euo pipefail

api=${MINIDOCK_API_URL:-http://127.0.0.1:8080}
api=${api%/}

usage() {
  cat >&2 <<'EOF'
Usage:
  minidock build -t NAME IMAGE.tar[.gz]
  minidock images
  minidock run [-m MEMORY] [-c CPU] [--network|--no-network] IMAGE COMMAND [ARG...]
  minidock ps
  minidock stop CONTAINER_ID

CPU accepts a percentage (50) or CPU count (0.5).
run starts a container and prints its ID/PID; terminal attachment is not supported yet.
EOF
  exit 2
}

command_name=${1:-}
[[ -n $command_name ]] || usage
shift

case "$command_name" in
  build)
    [[ ${1:-} == -t && $# -eq 3 ]] || usage
    name=$2
    archive=$3
    [[ -f $archive ]] || { echo "archive not found: $archive" >&2; exit 1; }
    curl --fail-with-body -sS -F "name=$name" -F "archive=@$archive" "$api/api/v1/images"
    ;;
  images)
    [[ $# -eq 0 ]] || usage
    curl --fail-with-body -sS "$api/api/v1/images"
    ;;
  run)
    memory=
    cpu=
    network_enabled=true
    while (($#)); do
      case "$1" in
        -m|--memory) (($# >= 2)) || usage; memory=$2; shift 2 ;;
        -c|--cpu) (($# >= 2)) || usage; cpu=$2; shift 2 ;;
        --network) network_enabled=true; shift ;;
        --no-network|--network=none) network_enabled=false; shift ;;
        --) shift; break ;;
        -*) usage ;;
        *) break ;;
      esac
    done
    (($# >= 2)) || usage
    image=$1
    shift
    if [[ $cpu =~ ^[1-9][0-9]?$ ]]; then cpu="${cpu}%"; fi
    payload=$(python3 -c 'import json,sys; image,memory,cpu,network=sys.argv[1:5]; command=sys.argv[5:]; print(json.dumps({"image":image,"command":command,"memory_limit":memory or None,"cpu_limit":cpu or None,"network":network == "true"}))' "$image" "$memory" "$cpu" "$network_enabled" "$@")
    curl --fail-with-body -sS -H 'Content-Type: application/json' -d "$payload" "$api/api/v1/containers"
    ;;
  ps)
    [[ $# -eq 0 ]] || usage
    curl --fail-with-body -sS "$api/api/v1/containers"
    ;;
  stop)
    [[ $# -eq 1 ]] || usage
    curl --fail-with-body -sS -X DELETE "$api/api/v1/containers/$1"
    ;;
  *) usage ;;
esac
printf '\n'
