PORT=8080
FRONTEND_URL=http://localhost:5173
OAUTH_REDIRECT_BASE=http://localhost:8080

# PostgreSQL
# Local development:
DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/foxvue?sslmode=disable
# Production (Neon, Azure, etc.) — change sslmode to require:
# DATABASE_URL=postgres://user:password@your-host:5432/your-db?sslmode=require

# JWT — use a long random string
JWT_SECRET=change-this-to-a-long-random-secret

# API Key Encryption — must be exactly 32 characters
API_KEY_ENCRYPTION_SECRET=change-this-32char-secret!!!!!!

# Gemini AI — comma-separated keys for automatic fallback
GEMINI_API_KEYS=your-gemini-key-1,your-gemini-key-2

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Microsoft OAuth
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT=common

# SMTP — Gmail App Password (no spaces in the password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=yourgmailapppassword
SMTP_FROM=you@gmail.com
